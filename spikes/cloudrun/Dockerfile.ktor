FROM eclipse-temurin:25-jre AS base
WORKDIR /app
COPY ktor/build/install/ktor-startup/lib/ /app/lib/
COPY ktor/data/1048576.bin /app/data.bin
COPY cloudrun/ktor-entry.sh /app/run.sh
RUN find /app/lib -name '*.jar' | LC_ALL=C sort | paste -sd: > /app/classpath.txt
ENV DATA_FILE=/app/data.bin PORT=8080
ENTRYPOINT ["sh","/app/run.sh"]
FROM base AS cds
RUN bash -c 'java -Xms32m -Xmx256m -XX:ArchiveClassesAtExit=/app/app.jsa -cp "$(cat /app/classpath.txt)" MainKt > /tmp/training.log 2>&1 & \
    pid=$!; ready=0; \
    for i in $(seq 1 120); do \
      if (exec 3<>/dev/tcp/127.0.0.1/8080; printf "GET /v1/recommend HTTP/1.0\r\n\r\n" >&3; read -r line <&3; [[ "$line" == *200* ]]) 2>/dev/null; then ready=1; break; fi; sleep 1; done; \
    kill -TERM $pid; wait $pid; test $ready -eq 1; test -s /app/app.jsa'
ENV SPIKE_CDS_FLAGS="-Xshare:on -XX:SharedArchiveFile=/app/app.jsa"
ENTRYPOINT ["sh","/app/run.sh"]
