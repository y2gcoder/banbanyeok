# 이 파일을 mise.local.toml로 복사해 값을 채운다. mise.local.toml은 gitignore 대상이다.
# 회사 1Password 계정과 섞이지 않도록 개인 계정을 고정한다(op는 --account가 없으면 가장 최근 로그인한 계정을 쓴다).
# 값은 `op account list`에서 개인 계정의 로그인 주소 또는 ID를 확인해 넣는다.
[env]
OP_ACCOUNT = "<개인 계정 로그인 주소 또는 ID>"
# 셸에 회사용 서비스 계정 토큰이 올라와 있어도 이 프로젝트에서는 쓰지 않는다.
# mise 문법으로 환경 변수를 해제(false)한다. 효과는 `mise run doctor`가 확인한다.
OP_SERVICE_ACCOUNT_TOKEN = false
