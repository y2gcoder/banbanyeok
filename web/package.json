{
  "name": "@banbanyeok/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:mock": "NEXT_PUBLIC_API_MOCKING=enabled node scripts/dev.ts",
    "mock": "node mock/main.ts",
    "build": "next build",
    "start": "next start",
    "gen": "pnpm gen:api && pnpm gen:stations",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/lib/api/schema.gen.ts",
    "gen:stations": "node scripts/build-station-index.ts",
    "check:contracts": "pnpm gen && git diff --exit-code -- src/lib/api/schema.gen.ts src/lib/stations/index.gen.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && eslint . && knip && depcruise src --config .dependency-cruiser.cjs",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "es-hangul": "2.4.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "nuqs": "2.10.2",
    "openapi-fetch": "0.17.0",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@opennextjs/cloudflare": "1.20.16",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "knip": "6.44.1",
    "openapi-typescript": "7.13.0",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wrangler": "4.158.0",
    "yaml": "2.9.1"
  }
}
