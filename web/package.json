{
  "name": "@banbanyeok/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:mock": "NEXT_PUBLIC_API_MOCKING=enabled node scripts/dev.ts",
    "mock": "node mock/main.ts",
    "build": "next build",
    "start": "next start",
    "gen": "pnpm gen:api && pnpm gen:stations && pnpm gen:og-font && pnpm gen:events && pnpm gen:time-slots && pnpm gen:problems",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/lib/api/schema.gen.ts",
    "gen:stations": "node scripts/build-station-index.ts && STATION_INDEX_ARTIFACTS=contracts/fixtures STATION_INDEX_OUT=web/src/lib/stations/regional.fixture.gen.json node scripts/build-station-index.ts && STATION_INDEX_CAPITAL_ONLY=1 STATION_INDEX_OUT=web/src/lib/stations/capital.fixture.gen.json node scripts/build-station-index.ts",
    "gen:og-font": "node scripts/build-og-font.ts",
    "gen:events": "node scripts/build-analytics-events.ts",
    "gen:icons": "node scripts/build-icons.ts",
    "gen:time-slots": "node scripts/build-time-slots.ts",
    "gen:problems": "node scripts/build-problems.ts",
    "check:contracts": "pnpm gen && git diff --exit-code -- src/lib/api/schema.gen.ts src/lib/stations/index.gen.json src/lib/stations/regional.fixture.gen.json src/lib/copy/og-glyphs.gen.json public/fonts src/lib/analytics/events.gen.ts src/lib/when/time-slots.gen.ts src/lib/problems/problems.gen.ts",
    "typecheck": "tsc --noEmit",
    "check:package-cycles": "node scripts/check-package-cycles.ts",
    "lint": "biome check . && eslint . && knip && depcruise src --config .dependency-cruiser.cjs && pnpm check:package-cycles",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test && playwright test --config playwright.analytics.config.ts",
    "e2e:real": "playwright test --config playwright.real.config.ts",
    "e2e:analytics": "playwright test --config playwright.analytics.config.ts",
    "ios-sim:line-break": "node scripts/ios-sim-line-break.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "es-hangul": "2.4.0",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "nuqs": "2.10.3",
    "openapi-fetch": "0.17.0",
    "posthog-js": "1.450.0",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@opennextjs/cloudflare": "1.20.17",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "knip": "6.45.1",
    "openapi-typescript": "7.13.0",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "wrangler": "4.163.0",
    "yaml": "2.9.1"
  }
}
